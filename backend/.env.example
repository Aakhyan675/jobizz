DJANGO_SETTINGS_MODULE=jobizz.settings.dev
DJANGO_SECRET_KEY=change-me-in-development-only
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=jobizz
POSTGRES_USER=jobizz
POSTGRES_PASSWORD=jobizz
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS — Vite default + production placeholders
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend origin used in password-reset emails (printed in DEBUG)
FRONTEND_URL=http://localhost:5173

# Email (console backend prints reset links in dev; swap to SMTP in prod)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Jobizz <noreply@jobizz.local>
